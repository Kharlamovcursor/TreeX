<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="treex.db" />
        <exclude domain="database" path="treex.db-shm" />
        <exclude domain="database" path="treex.db-wal" />
        <exclude domain="file" path="photos" />
        <exclude domain="file" path="history" />
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="treex.db" />
        <include domain="file" path="photos" />
        <include domain="file" path="history" />
    </device-transfer>
</data-extraction-rules>
